{
  "expo": {
    "name": "epices-agrotech",
    "slug": "epices-agrotech",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/WhatsApp Image 2026-10-17 at 10.09.21.jpeg",
    "scheme": "epicesagrotech",
    "userInterfaceStyle": "automatic",
    "updates": {
      "enabled": false
    },
    "ios": {
      "icon": "./assets/images/WhatsApp Image 2026-10-17 at 10.09.21.jpeg"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/WhatsApp Image 2026-10-17 at 10.09.21.jpeg"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/WhatsApp Image 2026-10-17 at 10.09.21.jpeg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-image",
      "expo-image-picker",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing",
      "expo-asset",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
